# Copy to .env for local runs. Never commit .env.
# In GitHub Actions, set these as repository secrets instead.

# Telegram alerts (see README: "Telegram setup")
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token
TELEGRAM_CHAT_ID=123456789

# Optional public channel (bot must be a channel admin)
TELEGRAM_CHANNEL_ID=@your_channel_username
CHANNEL_FOOTER=Join @your_channel_username for more iOS jobs
CHANNEL_MAX_POSTS=5
CHANNEL_MAX_AGE_DAYS=3

# Optional: Adzuna India job search (free key from https://developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional: AI analysis and application drafting (paid, usage-based)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_MAX_JOBS_PER_RUN=5

# Optional: email digest (Gmail needs an app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=

# Behaviour
MAX_NOTIFICATIONS=10
MAX_JOB_AGE_DAYS=30
DRY_RUN=false
# Only approval_required is supported. The bot never submits applications.
APPLICATION_MODE=approval_required
